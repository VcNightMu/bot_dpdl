# 少人WIKI 低配低练记录查询 Bot — 环境变量模板
#
# 用法：cp .env.example .env  然后按下面说明填写
# 注意：.env 已被 .gitignore 忽略，不要提交（里面有 Token）
#
# 服务器上容器【不挂载 .env】，配置靠 docker-compose 的 environment 传入；
# 用 docker run 手工起容器时，一个变量都不能漏，尤其是 WIKI_API_TOKEN
# （漏了 → token 为空 → 所有 Wiki API 调用 403 → bot 变哑巴）。

# ---------------------------------------------------------------------------
# NapCat（QQ 协议端）
# ---------------------------------------------------------------------------
# NapCat 服务地址。docker compose 内部用服务名 napcat；本机直连用 127.0.0.1
NAPCAT_HOST=napcat
NAPCAT_PORT=3001

# QQ 账号（仅 docker-compose 的 napcat 服务使用）
QQ_ACCOUNT=

# ---------------------------------------------------------------------------
# Bot 自身（FastAPI 监听地址）
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080

# ---------------------------------------------------------------------------
# 少人Wiki API
# ---------------------------------------------------------------------------
# 必须带 /v1/bot 后缀！漏了后缀所有调用都会 404。
WIKI_BASE_URL=https://wiki.arkrec.com/v1/bot

# Bot 鉴权 Token（请求头 X-Bot-Token）。向 Wiki 侧申请，务必保密。
WIKI_API_TOKEN=

# ---------------------------------------------------------------------------
# 以下配置项代码已支持从环境变量读取，但【尚未接线到实际调用点】，
# 改这里目前不生效（见 docs/接手简报.md「还没做的事」）：
#   WIKI_MAX_CONCURRENT / WIKI_TIMEOUT_CONNECT / WIKI_TIMEOUT_READ
#   MAX_MSG_LENGTH
# 仅 DEFAULT_STALE_DAYS 已真正生效。
# ---------------------------------------------------------------------------

# Wiki API 并发上限（未接线）
WIKI_MAX_CONCURRENT=10

# 连接超时 / 读取超时，单位秒（未接线）
WIKI_TIMEOUT_CONNECT=5.0
WIKI_TIMEOUT_READ=10.0

# QQ 单条消息长度上限（未接线：formatter/record.py 里是硬编码的 800）
MAX_MSG_LENGTH=800

# #待压人 的默认天数阈值（已生效）
DEFAULT_STALE_DAYS=365
